# ==============================================================================
# STUDENT MANAGEMENT SYSTEM - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode (development or production)
NODE_ENV=development

# Allowed Frontend URL for CORS & Outgoing Email Links
# In local development: http://localhost:5173
# In production on Render: https://your-frontend-app.onrender.com
CLIENT_URL=http://localhost:5173

# JWT & Cookie Signing Secrets (generate random strings in production)
AUTH_SECRET=your_super_secret_jwt_key_here_2026
COOKIE_SECRET=your_super_secret_cookie_key_here_2026

# ------------------------------------------------------------------------------
# NODEMAILER / SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# For Gmail:
#   1. Turn ON 2-Step Verification in your Google Account (myaccount.google.com).
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate a 16-character App Password (e.g. "abcd efgh ijkl mnop").
#   4. Set MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USER=your_email@gmail.com,
#      and MAIL_PASSWORD=your_16_character_app_password (without spaces).
#
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM="Student Management System" <your_email@gmail.com>

# Alternative SMTP Providers (SendGrid, Mailgun, Brevo, AWS SES):
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USER=apikey
# MAIL_PASSWORD=SG.your_sendgrid_api_key
# MAIL_FROM="Student Management System" <verified_sender@yourdomain.com>
